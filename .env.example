NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Option A: Claude API (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Option B: Local LLM via Ollama (Raspberry Pi)
# Set OLLAMA_API_URL to use your local Pi instead of Claude.
# OLLAMA_API_URL=http://192.168.1.XXX:11434
# OLLAMA_MODEL=gemma3   # default: gemma3
